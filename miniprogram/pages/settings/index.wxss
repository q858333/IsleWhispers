.page{min-height:100vh;box-sizing:border-box;padding:74rpx 36rpx 172rpx;background:linear-gradient(145deg,#d7a2a6,#fbf3dd 52%,#b8d4df);color:#332c36}.eyebrow,.title,.desc{display:block}.eyebrow{font-size:24rpx;letter-spacing:3rpx;color:rgba(51,44,54,.62)}.title{margin-top:12rpx;font-size:66rpx;font-weight:700}.desc{margin-top:16rpx;font-size:28rpx;line-height:1.6;color:rgba(51,44,54,.72)}.settings-list{margin-top:54rpx}.setting-card{min-height:124rpx;box-sizing:border-box;display:flex;align-items:center;gap:18rpx;width:100%;margin-bottom:18rpx;padding:22rpx;border-radius:28rpx;background:rgba(255,255,255,.74);color:#332c36;text-align:left;box-shadow:0 12rpx 30rpx rgba(102,75,83,.13)}.setting-icon{width:62rpx;height:62rpx;line-height:62rpx;border-radius:20rpx;background:#c4dff0;color:#34516a;text-align:center;font-size:32rpx;font-weight:700}.setting-copy{flex:1}.setting-title,.setting-detail{display:block}.setting-title{font-size:29rpx;font-weight:700}.setting-detail{margin-top:7rpx;font-size:22rpx;font-weight:400;color:rgba(51,44,54,.65)}.chevron{font-size:46rpx!important;font-weight:300!important;color:rgba(51,44,54,.38)!important}
.page{padding-top:104rpx}
