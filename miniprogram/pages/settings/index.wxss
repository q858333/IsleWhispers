.page{min-height:100vh;box-sizing:border-box;padding:74rpx 36rpx 172rpx;background:linear-gradient(145deg,#d7a2a6,#fbf3dd 52%,#b8d4df);color:#332c36}.eyebrow,.title,.desc{display:block}.eyebrow{font-size:24rpx;letter-spacing:3rpx;color:rgba(51,44,54,.62)}.title{margin-top:12rpx;font-size:66rpx;font-weight:700}.desc{margin-top:16rpx;font-size:28rpx;line-height:1.6;color:rgba(51,44,54,.72)}
.settings-list { margin-top: 48rpx; }
.setting-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-height: 144rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, .8);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .66);
  color: #332c36;
  text-align: left;
  line-height: 1.4;
  box-shadow: 0 4rpx 16rpx rgba(102, 75, 83, .04);
}
.setting-card-pressed { background: rgba(255, 255, 255, .9); }
.setting-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: rgba(87, 112, 117, .08);
}
.line-icon { width: 40rpx; height: 40rpx; background-size: contain; background-repeat: no-repeat; }
.setting-copy { flex: 1; min-width: 0; }
.setting-title, .setting-detail { display: block; }
.setting-title { font-size: 29rpx; font-weight: 600; }
.setting-detail { margin-top: 8rpx; font-size: 23rpx; font-weight: 400; line-height: 1.5; color: rgba(51, 44, 54, .56); }
.chevron { flex-shrink: 0; width: 12rpx; height: 12rpx; margin: 0 6rpx 0 4rpx; border-top: 2rpx solid rgba(51, 44, 54, .35); border-right: 2rpx solid rgba(51, 44, 54, .35); transform: rotate(45deg); }
.page { padding-top: 104rpx; }
