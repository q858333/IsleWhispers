<view class="page"><view class="art {{sound.theme}}"><text class="eyebrow">正在聆听</text><text class="title">{{sound.title}}</text><text class="subtitle">{{sound.subtitle}}</text></view><view class="controls"><button bindtap="previous">上一段</button><button class="play" bindtap="toggle">{{state.isPlaying ? '暂停' : '播放'}}</button><button bindtap="next">下一段</button></view><button class="mute" bindtap="mute">{{state.muted ? '取消静音' : '静音'}}</button><view class="timer"><text>睡眠定时：{{timerText}}</text><view><button data-minutes="0" bindtap="timer">不限时</button><button data-minutes="15" bindtap="timer">15 分钟</button><button data-minutes="30" bindtap="timer">30 分钟</button><button data-minutes="60" bindtap="timer">60 分钟</button></view></view><view wx:if="state.error" class="error">{{state.error}}</view><view class="recent"><text class="section">最近播放</text><view wx:if="!recent.length" class="empty">播放一段声音后会显示在这里</view><button wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="select">{{item.title}}</button></view></view>
