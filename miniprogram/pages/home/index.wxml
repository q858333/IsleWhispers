<view class="page">
  <cloud-image class="background" src="{{sound.backgroundPath}}" mode="aspectFill"/>
  <view class="backdrop"/>
  <view class="home-header"><view><text class="eyebrow">此刻 · 听见岛屿</text><text class="sound-title">{{sound.title}}</text></view><view class="header-actions"><button class="header-button mute-button" bindtap="toggleMute"><text class="speaker">{{state.muted ? '◑' : '◕'}}</text></button><button class="header-button recent-button" bindtap="openRecent">◷</button></view></view>
  <swiper class="sound-carousel" current="{{soundIndex}}" bindchange="changeSound" circular><swiper-item wx:for="{{sounds}}" wx:key="id"><view class="swipe-page"/></swiper-item></swiper>
  <view class="home-controls"><view class="page-dots"><text wx:for="{{sounds}}" wx:key="id" class="{{index === soundIndex ? 'dot active' : 'dot'}}"/></view><button class="primary-control" bindtap="openPlayer" aria-label="进入沉浸式播放"><view wx:if="{{state.isPlaying}}" class="waveform"><i/><i/><i/><i/><i/></view><text wx:else>▶</text></button><view class="timer-options"><button data-minutes="0" bindtap="setTimer" class="{{timerChoice === 0 ? 'timer-option selected' : 'timer-option'}}">不限时</button><button data-minutes="15" bindtap="setTimer" class="{{timerChoice === 15 ? 'timer-option selected' : 'timer-option'}}">15 分钟</button><button data-minutes="30" bindtap="setTimer" class="{{timerChoice === 30 ? 'timer-option selected' : 'timer-option'}}">30 分钟</button><button data-minutes="60" bindtap="setTimer" class="{{timerChoice === 60 ? 'timer-option selected' : 'timer-option'}}">60 分钟</button></view></view>
  <view wx:if="{{recentOpen}}" class="recent-page"><view class="recent-header"><text>最近播放</text><button class="recent-close" bindtap="closeRecent">×</button></view><view wx:if="{{recent.length}}" class="recent-grid"><button wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="selectRecent" class="recent-card"><cloud-image class="{{item.id === sound.id ? 'recent-art selected-art' : 'recent-art'}}" src="{{item.backgroundPath}}" mode="aspectFill"/><view wx:if="{{item.id === sound.id}}" class="playing-mark"><view class="mini-wave"><i/><i/><i/><i/></view></view><text class="recent-name">{{item.title}}</text></button></view><view wx:else class="recent-empty"><text class="empty-title">还没有最近播放</text><text class="empty-detail">开始聆听后，声音会显示在这里。</text></view></view>
</view>
