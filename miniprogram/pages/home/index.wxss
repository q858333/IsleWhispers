.page{min-height:100vh;position:relative;overflow:hidden;background:#172534;color:#fff}
.background,.backdrop{position:absolute;inset:0;width:100%;height:100%}
.backdrop{background:linear-gradient(180deg,rgba(8,16,27,.15),rgba(8,16,27,.06) 42%,rgba(8,16,27,.7))}
.home-header{position:relative;z-index:3;display:flex;justify-content:space-between;align-items:flex-start;padding:0 46rpx 0}
.eyebrow,.sound-title{display:block}.eyebrow{font-size:28rpx;color:rgba(255,255,255,.82);font-weight:600}.sound-title{margin-top:14rpx;font-size:60rpx;font-weight:700;letter-spacing:2rpx}
.header-actions{display:flex;gap:16rpx}.header-button{width:88rpx;height:88rpx;line-height:84rpx;padding:0;border-radius:50%;background:rgba(20,20,20,.38);color:#fff;font-size:42rpx}.mute-button,.recent-button{display:flex;align-items:center;justify-content:center}.speaker,.recent-clock{width:44rpx;height:44rpx;background-position:center;background-size:contain;background-repeat:no-repeat}
.sound-carousel{position:absolute;z-index:1;inset:0;width:100%;height:100vh}.swipe-page{width:100%;height:100%}
.home-controls{position:absolute;z-index:3;left:36rpx;right:36rpx;bottom:calc(156rpx + env(safe-area-inset-bottom));padding:26rpx 22rpx 28rpx;border:1rpx solid rgba(255,255,255,.14);border-radius:36rpx;background:rgba(15,22,20,.42);display:flex;flex-direction:column;align-items:center;backdrop-filter:blur(18rpx)}
.page-dots{height:26rpx;display:flex;gap:12rpx;align-items:center}.dot{width:10rpx;height:10rpx;border-radius:50%;background:rgba(255,255,255,.38)}.dot.active{width:16rpx;height:16rpx;background:#fff}
.primary-control{width:128rpx;height:128rpx;margin:16rpx 0 22rpx;padding:0;border-radius:50%;line-height:128rpx;background:#cde8fb;color:#172534;font-size:52rpx;box-shadow:0 12rpx 30rpx rgba(0,0,0,.2)}.waveform{height:128rpx;display:flex;align-items:center;justify-content:center;gap:7rpx}.waveform i,.mini-wave i{display:block;width:6rpx;border-radius:8rpx;background:#1a3445}.waveform i:nth-child(1){height:28rpx}.waveform i:nth-child(2){height:48rpx}.waveform i:nth-child(3){height:68rpx}.waveform i:nth-child(4){height:48rpx}.waveform i:nth-child(5){height:28rpx}
.timer-options{width:100%;min-width:0;white-space:nowrap}.timer-option{display:inline-block;min-width:140rpx;margin:0 12rpx 0 0;padding:18rpx 24rpx;border-radius:50rpx;background:rgba(70,72,64,.48);color:#fff;font-size:25rpx;white-space:nowrap}.timer-option:last-child{margin-right:0}.timer-option.selected{background:#cde8fb;color:#172534;font-weight:700}
.recent-page{position:fixed;z-index:30;inset:0;box-sizing:border-box;padding:0 28rpx calc(28rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;background:linear-gradient(135deg,#713b20,#251209);color:#fff}
.recent-header{display:flex;flex-shrink:0;justify-content:space-between;align-items:center;margin-bottom:32rpx;font-size:60rpx;font-weight:700}
.recent-close{flex-shrink:0;width:88rpx;height:88rpx;margin:0 0 0 auto;padding:0;border-radius:50%;line-height:82rpx;background:rgba(255,255,255,.14);color:#fff;font-size:48rpx}
.recent-scroll{flex:1;height:0;min-height:0}
.recent-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;padding-bottom:12rpx}
.recent-card{position:relative;width:100%;height:266rpx;margin:0;padding:0;box-sizing:border-box;overflow:hidden;border:3rpx solid transparent;border-radius:28rpx;background:#765c55;color:#fff;text-align:left;box-shadow:0 12rpx 24rpx rgba(0,0,0,.15)}
.recent-card-selected{border-color:#fff}
.recent-art,.recent-shade{position:absolute;inset:0;width:100%;height:100%}
.recent-shade{background:linear-gradient(180deg,rgba(0,0,0,.02),rgba(0,0,0,.65))}
.recent-copy{position:absolute;z-index:1;left:18rpx;right:18rpx;bottom:18rpx}
.recent-name,.recent-subtitle{display:block}.recent-name{font-size:29rpx;font-weight:700}.recent-subtitle{margin-top:7rpx;color:rgba(255,255,255,.76);font-size:21rpx;font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.playing-mark{position:absolute;right:14rpx;top:16rpx;width:64rpx;height:64rpx;border-radius:50%;background:rgba(35,35,35,.42)}.mini-wave{height:64rpx;display:flex;justify-content:center;align-items:center;gap:4rpx}.mini-wave i:nth-child(1){height:18rpx}.mini-wave i:nth-child(2){height:31rpx}.mini-wave i:nth-child(3){height:24rpx}.mini-wave i:nth-child(4){height:14rpx}
.recent-empty{height:62vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}.empty-title{font-size:38rpx;font-weight:700}.empty-detail{margin-top:14rpx;font-size:26rpx;color:rgba(255,255,255,.72)}

.speaker-on{background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22white%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M11%205%206%209H3v6h3l5%204V5Z%22%2F%3E%3Cpath%20d%3D%22M15%208a6%206%200%200%201%200%208M18%205a10%2010%200%200%201%200%2014%22%2F%3E%3C%2Fsvg%3E")}
.speaker-muted{background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22white%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M11%205%206%209H3v6h3l5%204V5Z%22%2F%3E%3Cpath%20d%3D%22m16%209%205%206m0-6-5%206%22%2F%3E%3C%2Fsvg%3E")}



.recent-clock{background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22white%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2212%22%20cy%3D%2212%22%20r%3D%229%22%2F%3E%3Cpath%20d%3D%22M12%206v6h5%22%2F%3E%3C%2Fsvg%3E")}

.audio-status{display:block;margin-top:14rpx;font-size:22rpx;font-weight:400;line-height:1.5;color:rgba(255,255,255,.78)}
