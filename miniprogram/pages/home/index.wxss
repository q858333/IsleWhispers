.page{min-height:100vh;position:relative;overflow:hidden;background:#172534;color:#fff}
.background,.backdrop{position:absolute;inset:0;width:100%;height:100%}
.backdrop{background:linear-gradient(180deg,rgba(8,16,27,.26),rgba(8,16,27,.06) 42%,rgba(8,16,27,.7))}
.home-header{position:relative;z-index:3;display:flex;justify-content:space-between;align-items:flex-start;padding:94rpx 46rpx 0}
.eyebrow,.sound-title{display:block}.eyebrow{font-size:28rpx;color:rgba(255,255,255,.82);font-weight:600}.sound-title{margin-top:14rpx;font-size:60rpx;font-weight:700;letter-spacing:2rpx}
.header-actions{display:flex;gap:16rpx}.header-button{width:88rpx;height:88rpx;line-height:84rpx;padding:0;border-radius:50%;background:rgba(20,20,20,.38);color:#fff;font-size:42rpx}.speaker{font-size:36rpx}
.sound-carousel{position:absolute;z-index:1;inset:0;width:100%;height:100vh}.swipe-page{width:100%;height:100%}
.home-controls{position:absolute;z-index:3;left:36rpx;right:36rpx;bottom:156rpx;padding:26rpx 22rpx 28rpx;border:1rpx solid rgba(255,255,255,.14);border-radius:36rpx;background:rgba(15,22,20,.42);display:flex;flex-direction:column;align-items:center;backdrop-filter:blur(18rpx)}
.page-dots{height:26rpx;display:flex;gap:12rpx;align-items:center}.dot{width:10rpx;height:10rpx;border-radius:50%;background:rgba(255,255,255,.38)}.dot.active{width:16rpx;height:16rpx;background:#fff}
.primary-control{width:128rpx;height:128rpx;margin:16rpx 0 22rpx;padding:0;border-radius:50%;line-height:128rpx;background:#cde8fb;color:#172534;font-size:52rpx;box-shadow:0 12rpx 30rpx rgba(0,0,0,.2)}.waveform{height:128rpx;display:flex;align-items:center;justify-content:center;gap:7rpx}.waveform i,.mini-wave i{display:block;width:6rpx;border-radius:8rpx;background:#1a3445}.waveform i:nth-child(1){height:28rpx}.waveform i:nth-child(2){height:48rpx}.waveform i:nth-child(3){height:68rpx}.waveform i:nth-child(4){height:48rpx}.waveform i:nth-child(5){height:28rpx}
.timer-options{width:100%;display:flex;gap:12rpx}.timer-option{flex:1;margin:0;padding:18rpx 4rpx;border-radius:50rpx;background:rgba(70,72,64,.48);color:#fff;font-size:25rpx;white-space:nowrap}.timer-option.selected{background:#cde8fb;color:#172534;font-weight:700}
.recent-page{position:fixed;z-index:30;inset:0;box-sizing:border-box;padding:112rpx 28rpx 44rpx;background:linear-gradient(135deg,#713b20,#251209);color:#fff}.recent-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:72rpx;font-size:60rpx;font-weight:700}.recent-close{width:88rpx;height:88rpx;padding:0;border-radius:50%;line-height:82rpx;background:rgba(255,255,255,.14);color:#fff;font-size:48rpx}
.recent-grid{display:grid;grid-template-columns:repeat(2,200rpx);gap:48rpx;justify-content:start}.recent-card{position:relative;padding:0;background:transparent;color:#fff;text-align:center;font-size:32rpx}.recent-art{width:200rpx;height:286rpx;border-radius:100rpx;background:#3b2419}.selected-art{box-sizing:border-box;border:4rpx solid #fff}.recent-name{display:block;margin-top:20rpx}.playing-mark{position:absolute;right:14rpx;top:16rpx;width:64rpx;height:64rpx;border-radius:50%;background:rgba(35,35,35,.42)}.mini-wave{height:64rpx;display:flex;justify-content:center;align-items:center;gap:4rpx}.mini-wave i:nth-child(1){height:18rpx}.mini-wave i:nth-child(2){height:31rpx}.mini-wave i:nth-child(3){height:24rpx}.mini-wave i:nth-child(4){height:14rpx}
.recent-empty{height:62vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}.empty-title{font-size:38rpx;font-weight:700}.empty-detail{margin-top:14rpx;font-size:26rpx;color:rgba(255,255,255,.72)}
