<view class="page">
  <view class="nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-inner" style="height: {{navBarHeight}}px">
      <button class="nav-back" bindtap="back" aria-label="返回">‹</button>
      <text class="nav-title">素材与授权</text>
    </view>
  </view>
  <view class="content" style="padding-top: {{topInset}}px">
    <text class="intro">全部音频为开发者自有的 AI 生成素材，云端文件散列已留档。</text>
    <view wx:for="{{assets}}" wx:key="id" class="item">
      <text>{{item.title}}</text>
      <text>{{item.author}} · {{item.license}}</text>
    </view>
  </view>
</view>
