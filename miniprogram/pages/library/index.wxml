<view class="page"><view class="top-copy"><text class="eyebrow">岛屿声音库</text><text class="title">声音</text><text class="desc">选择此刻想听见的自然</text></view><view wx:for="{{groups}}" wx:key="name" class="sound-section"><text class="heading">{{item.name}}</text><view class="sound-grid"><button wx:for="{{item.items}}" wx:key="id" data-id="{{item.id}}" bindtap="select" class="sound-card"><image class="card-image" src="{{item.backgroundPath}}" mode="aspectFill"/><view class="card-shade"/><view class="card-copy"><text class="card-title">{{item.title}}</text><text class="card-sub">{{item.subtitle}}</text></view></button></view></view></view>
