.page{min-height:100vh;box-sizing:border-box;padding:68rpx 32rpx 172rpx;background:linear-gradient(180deg,#b98d8e,#faf2d9 42%,#f1e6d7);color:#432e2e}.top-copy{padding:0 8rpx 38rpx}.eyebrow,.title,.desc{display:block}.eyebrow{font-size:24rpx;letter-spacing:3rpx;color:rgba(67,46,46,.7)}.title{margin-top:10rpx;font-size:66rpx;font-weight:700}.desc{margin-top:12rpx;font-size:27rpx;color:rgba(67,46,46,.72)}.sound-section{margin-bottom:34rpx}.heading{display:block;margin:0 8rpx 18rpx;font-size:34rpx;font-weight:700}.sound-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}.sound-card{position:relative;height:266rpx;padding:0;overflow:hidden;border-radius:28rpx;background:#765c55;color:#fff;text-align:left;box-shadow:0 12rpx 24rpx rgba(90,55,50,.15)}.card-image,.card-shade{position:absolute;inset:0;width:100%;height:100%}.card-shade{background:linear-gradient(180deg,rgba(0,0,0,.02),rgba(0,0,0,.65))}.card-copy{position:absolute;z-index:1;left:18rpx;right:18rpx;bottom:18rpx}.card-title,.card-sub{display:block}.card-title{font-size:29rpx;font-weight:700}.card-sub{margin-top:7rpx;color:rgba(255,255,255,.76);font-size:21rpx;font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.page{padding-top:100rpx}
.sound-card{width:100%;margin:0;box-sizing:border-box}
