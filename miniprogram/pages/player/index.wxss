.page{min-height:100vh;position:relative;overflow:hidden;background:#172534;color:#fff}.background,.shade{position:absolute;inset:0;width:100%;height:100%}.shade{background:linear-gradient(180deg,rgba(8,15,25,.34),rgba(8,15,25,.1) 42%,rgba(8,15,25,.38))}.content{position:relative;z-index:1;min-height:100vh;box-sizing:border-box;padding:78rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column}.top-row{display:flex;align-items:flex-start;justify-content:space-between}.brand,.page-name{display:block}.brand{font-size:24rpx;letter-spacing:3rpx;color:rgba(255,255,255,.82)}.page-name{margin-top:10rpx;font-size:40rpx;font-weight:700}.icon-button,.close-button{width:88rpx;height:88rpx;padding:0;line-height:84rpx;border-radius:50%;background:rgba(0,0,0,.3);color:#fff;font-size:42rpx}.title{display:block;flex:1;min-width:0;padding:8rpx 24rpx 0 0;font-size:56rpx;font-weight:600;line-height:1.3}.subtitle{display:block;margin-top:16rpx;font-size:28rpx;color:rgba(255,255,255,.78)}.error{margin-top:24rpx;color:#ffd5d1;font-size:24rpx}.bottom-controls{margin-top:auto;text-align:center}.timer-card{display:inline-flex;flex-direction:column;min-width:188rpx;padding:20rpx 38rpx;border:1rpx solid rgba(255,255,255,.15);border-radius:32rpx;background:rgba(11,16,19,.38);backdrop-filter:blur(16rpx)}.countdown{display:block;margin:0 auto;padding:16rpx 0;width:100%;background:transparent;color:#fff;font-size:72rpx;font-weight:300;line-height:1.4;font-variant-numeric:tabular-nums}.countdown-caption{display:block;margin-top:10rpx;font-size:24rpx;color:rgba(255,255,255,.7)}.control-row{position:relative;margin-top:16rpx;min-height:144rpx;display:flex;justify-content:center;align-items:center}.primary-control{width:144rpx;height:144rpx;padding:0;line-height:144rpx;border-radius:50%;background:#cde8fb;color:#253d58;font-size:48rpx;box-shadow:0 14rpx 36rpx rgba(0,0,0,.25)}.close-button{position:absolute;right:0;top:16rpx;width:112rpx;height:112rpx;line-height:108rpx}.sheet-mask{position:fixed;z-index:25;inset:0;background:rgba(0,0,0,.48);display:flex;align-items:flex-end}.picker-sheet,.timer-sheet{width:100%;box-sizing:border-box;padding:20rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));border-radius:36rpx 36rpx 0 0;background:#fdf9f4;color:#273545}.picker-sheet{height:70vh}.sheet-handle{width:72rpx;height:8rpx;margin:0 auto 26rpx;border-radius:8rpx;background:#d1c7bf}.sheet-title{display:block;font-size:36rpx;font-weight:700;margin-bottom:22rpx}.sound-list{height:calc(70vh - 150rpx - env(safe-area-inset-bottom))}.sound-option{display:flex;align-items:center;gap:18rpx;margin:12rpx 0;padding:16rpx;background:#f3ece4;text-align:left;color:#273545}.sound-option.selected{background:#dfe8ee}.option-image{width:92rpx;height:92rpx;border-radius:16rpx}.option-title,.option-subtitle{display:block}.option-subtitle{margin-top:6rpx;color:#776b63;font-size:23rpx}.timer-sheet button{margin:14rpx 0;background:#f3ece4;color:#273545}
.retry-button{margin:16rpx auto 24rpx;width:192rpx;background:rgba(183,55,50,.85);color:#fff;border-radius:40rpx;font-size:28rpx}
