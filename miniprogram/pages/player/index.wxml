<view class="page">
  <cloud-image class="background" src="{{sound.backgroundPath}}" mode="aspectFill"/>
  <view class="shade"/>
  <view class="content" style="padding-top: {{topInset}}px">
    <view class="top-row"><text class="title">{{sound.title}}</text><button class="icon-button" bindtap="showPicker" aria-label="选择声音">☷</button></view>
    <text wx:if="{{state.audioStatus === 'downloading'}}" class="audio-status">正在下载音频…</text>
    <view wx:if="{{hasTimer || isRinging}}" class="timer-clock" aria-label="当前时间 {{currentHour}}:{{currentMinute}}，{{endTimeText}}">
      <text class="clock-hour">{{currentHour}}</text>
      <text class="clock-minute">{{currentMinute}}</text>
      <button class="clock-deadline" bindtap="tapDeadline">{{endTimeText}}</button>
    </view>
    <view class="bottom-controls"><view wx:if="{{state.error}}" class="error"><text>{{state.error}}</text><button class="retry-button" bindtap="retry">重试</button></view><button wx:if="{{!hasTimer && !isRinging}}" class="timer-entry" bindtap="showTimer">睡眠定时</button><view class="control-row"><button class="primary-control" bindtap="toggle" aria-label="{{state.isPlaying ? '暂停' : '播放'}}">{{state.isPlaying ? 'Ⅱ' : '▶'}}</button><button wx:if="{{!state.isPlaying || state.error}}" class="close-button" bindtap="close" aria-label="结束聆听">×</button></view></view>
  </view>
  <view wx:if="{{pickerOpen}}" class="sheet-mask" bindtap="hidePicker"><view class="picker-sheet" catchtap="noop"><view class="sheet-handle"/><text class="sheet-title">选择声音</text><scroll-view scroll-y class="sound-list"><button wx:for="{{sounds}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseSound" class="{{item.id === sound.id ? 'sound-option selected' : 'sound-option'}}"><cloud-image class="option-image" src="{{item.backgroundPath}}" mode="aspectFill"/><view><text class="option-title">{{item.title}}</text><text class="option-subtitle">{{item.subtitle}}</text></view></button></scroll-view></view></view>
  <view wx:if="{{timerOpen}}" class="sheet-mask" bindtap="hideTimer"><view class="timer-sheet" catchtap="noop"><view class="sheet-handle"/><text class="sheet-title">睡眠定时</text><view class="timer-bell-row"><view class="timer-bell-copy"><text class="timer-bell-title">定时到期响铃</text><text class="timer-bell-detail">{{timerBellEnabled ? '到期停止播放，并响铃 30 秒' : '到期只停止播放，不响铃'}}</text></view><switch checked="{{timerBellEnabled}}" bindchange="changeTimerBell" color="#577075" aria-label="定时到期响铃"/></view><scroll-view class="timer-durations" scroll-y="{{true}}"><button data-minutes="0" bindtap="timer">不限时</button><button wx:if="{{isDevelop}}" data-seconds="20" bindtap="timer">20 秒（测试）</button><button data-minutes="15" bindtap="timer">15 分钟</button><button data-minutes="30" bindtap="timer">30 分钟</button><button data-minutes="60" bindtap="timer">60 分钟</button><button data-minutes="90" bindtap="timer">90 分钟</button><button data-minutes="120" bindtap="timer">120 分钟</button></scroll-view></view></view>
</view>
