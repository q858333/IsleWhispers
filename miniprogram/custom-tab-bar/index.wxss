.tab-shell{position:fixed;z-index:20;left:0;right:0;bottom:0;padding:0 42rpx calc(18rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,transparent,rgba(8,14,16,.28))}.tab-shell-light{background:linear-gradient(180deg,transparent,rgba(255,251,244,.34))}.tab-pill{height:118rpx;display:flex;align-items:center;justify-content:space-around;border:1rpx solid rgba(255,255,255,.14);border-radius:62rpx;background:rgba(18,22,20,.76);backdrop-filter:blur(20rpx);box-shadow:0 12rpx 28rpx rgba(0,0,0,.24)}.tab-pill-light{border-color:rgba(72,56,52,.12);background:rgba(255,255,255,.74);box-shadow:0 12rpx 28rpx rgba(110,82,73,.15)}.tab-item{width:31%;height:94rpx;padding:8rpx 0 0;border-radius:50rpx;background:transparent;color:rgba(255,255,255,.86);font-size:22rpx;line-height:1.1}.tab-item-light{color:rgba(67,46,46,.66)}.tab-item.active{background:rgba(190,219,238,.22);color:#d9efff}.tab-item-light.active{background:rgba(171,207,230,.46);color:#34516a}.tab-icon{display:block;width:42rpx;height:42rpx;margin:0 auto 5rpx;filter:brightness(0) invert(1)}.tab-icon-light{filter:brightness(0) opacity(.58)}.tab-icon-active{filter:none}
