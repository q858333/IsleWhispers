<view class="tab-shell {{appearance === 'light' ? 'tab-shell-light' : ''}}">
  <view class="tab-pill {{appearance === 'light' ? 'tab-pill-light' : ''}}">
    <button wx:for="{{tabs}}" wx:key="text" data-index="{{index}}" bindtap="switchTab" class="tab-item {{selected === index ? 'active' : ''}} {{appearance === 'light' ? 'tab-item-light' : ''}}">
      <image class="tab-icon {{selected === index ? 'tab-icon-active' : ''}} {{appearance === 'light' ? 'tab-icon-light' : ''}} {{selected === 0 && index === 0 ? 'tab-icon-home-selected' : ''}}" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit"/>
      <text>{{item.text}}</text>
    </button>
  </view>
</view>
