<view class="tab-shell">
  <view class="tab-pill">
    <button wx:for="{{tabs}}" wx:key="text" data-index="{{index}}" bindtap="switchTab" class="{{selected === index ? 'tab-item active' : 'tab-item'}}">
      <image class="{{selected === index ? 'tab-icon tab-icon-active' : 'tab-icon'}}" src="{{selected === index ? item.activeIcon : item.icon}}" mode="aspectFit"/>
      <text>{{item.text}}</text>
    </button>
  </view>
</view>
