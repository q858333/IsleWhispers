    "help.faq.background.answer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start playback, then leave the app. You can pause or resume from Control Center."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始播放后可切到后台，也可在控制中心暂停或继续。"
