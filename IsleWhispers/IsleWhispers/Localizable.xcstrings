    "help.faq.playback.question" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "How do I change sounds?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "如何切换声音？" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "如何切換聲音？" } } } },
    "help.faq.playback.answer" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Swipe left or right on Home, or choose a sound from the library." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在首页左右滑动，或从声音列表选择。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在首頁向左或向右滑動，或從聲音庫選擇聲音。" } } } },
    "help.faq.timer.question" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "How does the timer work?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "倒计时如何工作？" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "倒數計時如何運作？" } } } },
    "help.faq.timer.answer" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose No Limit, 15, 30, or 60 minutes. The timer pauses when playback pauses." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可选择不限时、15、30、60 分钟；暂停时倒计时同步暂停。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可選擇不限時、15、30 或 60 分鐘；暫停播放時，倒數計時也會暫停。" } } } },
    "help.faq.background.question" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "How do I play in the background?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "如何后台播放？" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "如何在背景播放？" } } } },
    "help.faq.background.answer" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start playback, then leave the app. You can pause or resume from Control Center." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始播放后可切到后台，也可在控制中心暂停或继续。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開始播放後即可離開 App，也可從控制中心暫停或繼續播放。" } } } },
    "help.faq.notifications.question" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Why did I not receive a notification?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "为什么没有通知？" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "為什麼沒有收到通知？" } } } },
